# TMDB: API Key (v3) o API Read Access Token (v4, empieza por "eyJ"). Cualquiera de los dos vale.
TMDB_API_KEY=

# Upstash Redis (Vercel lo rellena solo al conectar la base de datos desde Storage).
# Sin estas variables, en local los perfiles se guardan en .data/store.json
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Firma de las sesiones de perfil (token tras el PIN) y anonimización de IPs. Opcional: sin ella se deriva de
# CRON_SECRET o de TMDB_API_KEY. Genera una con: openssl rand -base64 32
SESSION_SECRET=

# Críticas (opcionales; sin ellas se usan TMDB, Wikipedia y blogs por RSS):
# Reddit: crea una app de tipo «script» en https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Rotten Tomatoes, Metacritic e IMDb: clave gratuita en https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
